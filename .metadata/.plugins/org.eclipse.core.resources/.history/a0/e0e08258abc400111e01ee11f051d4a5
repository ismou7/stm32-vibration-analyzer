uint8_t  Write_Complete;
int __io_putchar(int ch)
{
	uart_write(ch);

	return ch;
}
int main(void)
{
  /*Init Uarttx driver*/
  UART2_TX_Init();

  /*Init ADC1 channel1*/
  ADC1_Init();

  /*Start ADC1 conversion*/
  start_conversion();

  /*Init TIM2*/
  Tim2_Init();

  /*Init Fifo array*/
  Fifo_reset();

  while(1)
  {

  }
}

void TIM2_IRQHandler(void)
{

  if(TIM2->SR & SR_UIF)
  {
	static int n = 0;
   /*Clear update interrupt flag*/
   TIM2->SR &= ~SR_UIF;

   while(n <=FIFOMAXSIZE)
   {
    Fifo_Write(read_ADC1());
    n++;
   }
   if(n == FIFOMAXSIZE)
   {
	  n = 0;
	  Write_Complete = 1;
   }
  }
}
