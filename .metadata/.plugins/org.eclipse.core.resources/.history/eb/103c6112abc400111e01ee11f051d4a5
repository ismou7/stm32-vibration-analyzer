#include <stdint.h>
#include <stdio.h>
#include "uart.h"
#include "adc.h"
#include "tim.h"
#include "fifo.h"

uint32_t g_read_sensor;
int __io_putchar(int ch)
{
	uart_write(ch);

	return ch;
}
int main(void)
{
  /*Init Uarttx driver*/
  UART2_TX_Init();

  /*Init ADC1 channel1*/
  ADC1_Init();

  /*Start ADC1 conversion*/
  start_conversion();

  /*Init TIM2*/
  Tim2_Init();

  /*Init Fifo array*/
  Fifo_reset();

  while(1)
  {

  }
}

void TIM2_IRQHandler(void)
{

  if(TIM2->SR & SR_UIF)
  {
   /*Clear update interrupt flag*/
   TIM2->SR &= ~SR_UIF;

   Fifo_Write(read_ADC1());
   //printf("%ld\n\r",g_read_sensor);
  }
}
