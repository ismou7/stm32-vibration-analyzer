#include "uart.h"

#define UART1ENR (1U<<4)
#define GPIOAENR (1U<<0)
#define TXESR    (1U<<7)
#define UARTBAUDRATE 115200
#define SYSCLK 16000000
void UART1_TX_Init(void)
{

	/*Enable GPIOA clock*/
	RCC->AHB1ENR |= GPIOAENR;

	/*Set PA9  to alternate funktion mode*/

	GPIOA->MODER &= ~(1U<<18);
	GPIOA->MODER |= (1U<<19);

    GPIOA->AFR[1] |= (1U<<4);
    GPIOA->AFR[1] |= (1U<<5);
    GPIOA->AFR[1] |= (1U<<6);
    GPIOA->AFR[1] &= ~(1U<<7);

	/*Enable UART1 Clock*/
    RCC->APB2ENR |= UART1ENR;

    /*Enable TE Transmitter*/
    USART1->CR1 |= (1U<<3);

    /*Set baudrate */

    USART1->BRR = ((SYSCLK + (UARTBAUDRATE/2U))/UARTBAUDRATE);

    /*Enable UART1*/
    USART1->CR1 |= (1U<<13);

}

void uart_write(int ch)
{
	/*Wait until data register is empty*/
	while(!(USART1->SR & TXESR)){}

	/*Write to the transmitter data register*/
	USART1->DR = (ch & 0xFF);
}
