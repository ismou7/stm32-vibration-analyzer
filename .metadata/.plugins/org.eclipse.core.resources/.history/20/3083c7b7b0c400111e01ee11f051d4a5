#include <stdint.h>
#include <stdio.h>
#include "uart.h"
#include "adc.h"
#include "tim.h"
#include "fifo.h"

uint32_t g_read_sensor;
uint8_t  g_Fifo_Full;
uint8_t g_Fifo_empty = 1;
uint8_t g_Process;
int __io_putchar(int ch)
{
	uart_write(ch);

	return ch;
}
int main(void)
{
  /*Init Uarttx driver*/
  UART2_TX_Init();

  /*Init ADC1 channel1*/
  ADC1_Init();

  /*Start ADC1 conversion*/
  start_conversion();

  /*Init TIM2*/
  Tim2_Init();

  /*Init Fifo array*/
  Fifo_reset();

  while(1)
  {
     if(g_Process == 1)
     {
    	for(int i = 0;i <=FIFOMAXSIZE; i++)
    	{
    		g_Fifo_empty = Fifo_Read(&g_read_sensor);
    		printf("%ld\n\r",g_read_sensor);
    	}
    	g_Process = 0;
     }
  }
}
static void Tim2_callback(void)
{
	if(g_Fifo_Full == 1)
	{
		/*Fifo is not full*/
		g_Fifo_Full = Fifo_Write(read_ADC1());
	}
	else
	{
		g_Process = 1;
	}
}
void TIM2_IRQHandler(void)
{

  if(TIM2->SR & SR_UIF)
  {
   /*Clear update interrupt flag*/
   TIM2->SR &= ~SR_UIF;

   Tim2_callback();
  }
}
