#include <stdint.h>
#include <stdio.h>
#include "uart.h"
#include "adc.h"

uint32_t g_read_sensor;
int __io_putchar(int ch)
{
	uart_write(ch);

	return ch;
}
int main(void)
{
  /*Init Uarttx driver*/
  UART2_TX_Init();

  /*Init ADC1 channel1*/
  ADC1_Init();

  /*Start ADC1 conversion*/
  start_conversion():

  while(1)
  {
	  g_read_sensor = read_ADC1();
	  printf("%ld\n\r",g_read_sensor);
  }
}
